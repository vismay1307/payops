# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PayPal sandbox only — invariant I-04
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Added on Day 4; obtain the actual ID in Step 8
PAYPAL_WEBHOOK_ID=

# Local PostgreSQL
# Replace <password> with your own local DB password
DATABASE_URL=postgres://payops:<my-password>@localhost:5434/payops

# Sandbox test accounts for invoice spike
PAYPAL_BUYER_EMAIL=
PAYPAL_MERCHANT_EMAIL=